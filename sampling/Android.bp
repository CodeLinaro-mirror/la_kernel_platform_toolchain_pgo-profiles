soong_namespace {
}

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

fdo_profile {
    name: "keystore2",
    profile: select(release_flag("RELEASE_BUILD_AFDO_PROFILE_VERSION"), {
        "": "",
        any @ version: version + "/keystore2.afdo",
    }),
}

fdo_profile {
    name: "libart",
    arch: {
        arm64: {
            profile: "libart_arm64.afdo",
        },
    },
}

